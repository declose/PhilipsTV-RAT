<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PhilipsControl</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Philips Control</Product>
    <Version>2.0.0</Version>
    <Authors>Philips Control</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms implicit usings would make Button, Application, etc. ambiguous with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
