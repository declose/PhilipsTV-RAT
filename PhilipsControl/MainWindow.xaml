                        </ScrollViewer>

                        <!-- ============ REMOTE ============ -->
                        <ScrollViewer x:Name="RemotePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,8,0">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="336" CornerRadius="22" Background="#0B0F0B" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20,18" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Grid>
                                            <Button Tag="Standby" Click="RemoteKey_Click" HorizontalAlignment="Left" Width="46" Height="46" Padding="0" Foreground="{StaticResource Danger}" ToolTip="Standby key (P toggles power)"><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="16"/></Button>
                                            <TextBlock Text="P H I L I P S" Foreground="{StaticResource Faint}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Tag="Source" Click="RemoteKey_Click" HorizontalAlignment="Right" Height="46" Padding="12,0" ToolTip="Source (S)"><TextBlock Text="SOURCE"/></Button>
                                        </Grid>

                                        <Grid Margin="0,18,0,0" Height="210">
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Ellipse Grid.RowSpan="3" Grid.ColumnSpan="3" Width="206" Height="206" Fill="#0E140E" Stroke="{StaticResource LineSoft}" StrokeThickness="1"/>
                                            <Button Grid.Row="0" Grid.Column="0" Tag="Back" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" VerticalAlignment="Top" HorizontalAlignment="Left" ToolTip="Back (Backspace / Esc)"><TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}"/></Button>
                                            <Button Grid.Row="0" Grid.Column="2" Tag="Home" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="Home (H)"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}"/></Button>
                                            <Button Grid.Row="2" Grid.Column="0" Tag="Info" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" HorizontalAlignment="Left" ToolTip="Info (I)"><TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}"/></Button>
                                            <Button Grid.Row="2" Grid.Column="2" Tag="Options" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" HorizontalAlignment="Right" ToolTip="Options (O)"><TextBlock Text="&#xE712;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}"/></Button>
                                            <Button Grid.Row="0" Grid.Column="1" Tag="CursorUp" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Width="60" Height="54" VerticalAlignment="Bottom" ToolTip="Up"><TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="18"/></Button>
                                            <Button Grid.Row="1" Grid.Column="0" Tag="CursorLeft" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Width="54" Height="60" HorizontalAlignment="Right" ToolTip="Left"><TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="18"/></Button>
                                            <Button Grid.Row="1" Grid.Column="1" Tag="Confirm" Click="RemoteKey_Click" Style="{StaticResource OkButton}" Width="74" Height="74" Margin="0" Content="OK" ToolTip="OK (Enter)"/>
                                            <Button Grid.Row="1" Grid.Column="2" Tag="CursorRight" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Width="54" Height="60" HorizontalAlignment="Left" ToolTip="Right"><TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="18"/></Button>
                                            <Button Grid.Row="2" Grid.Column="1" Tag="CursorDown" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Width="60" Height="54" VerticalAlignment="Top" ToolTip="Down"><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="18"/></Button>
                                        </Grid>

                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                                            <Border CornerRadius="30" Background="#0F150F" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                <StackPanel>
                                                    <Button Tag="VolumeUp" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Height="48" ToolTip="Volume up (+)"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}"/></Button>
                                                    <TextBlock Text="VOL" Foreground="{StaticResource Faint}" FontSize="10" HorizontalAlignment="Center" Margin="0,2"/>
                                                    <Button Tag="VolumeDown" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Height="48" ToolTip="Volume down (-)"><TextBlock Text="&#xE738;" Style="{StaticResource Icon}"/></Button>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <Button Tag="Mute" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" ToolTip="Mute (M)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74F;" Style="{StaticResource Icon}"/><TextBlock Text="MUTE" Margin="8,0,0,0"/></StackPanel></Button>
                                                <Button Tag="AmbilightOnOff" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" ToolTip="Ambilight on/off (A)"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE706;" Style="{StaticResource Icon}"/><TextBlock Text="AMBI" Margin="8,0,0,0"/></StackPanel></Button>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="30" Background="#0F150F" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                <StackPanel>
                                                    <Button Tag="ChannelStepUp" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Height="48" ToolTip="Channel up (Page Up)"><TextBlock Text="&#xE70E;" Style="{StaticResource Icon}"/></Button>
