                                                <Button Tag="remote" Click="GoToPage_Click" Margin="3" Padding="6,10"><StackPanel><TextBlock Text="&#xE951;" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="REMOTE" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sleep timer -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="SLEEP TIMER" Style="{StaticResource SectionLabel}"/>
