                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <CheckBox x:Name="AmbilightSwitch" Style="{StaticResource Switch}" Click="AmbilightSwitch_Click" IsChecked="{Binding AmbilightOn, Mode=TwoWay}">
                                                <StackPanel>
                                                    <TextBlock Text="AMBILIGHT" Style="{StaticResource SectionLabel}"/>
                                                    <TextBlock Text="{Binding AmbilightMode}" FontSize="17" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="FOLLOW VIDEO" Style="{StaticResource SectionLabel}"/>
