                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="RELOAD LIST" Margin="8,0,0,0"/></StackPanel>
                                </Button>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="OPEN NOW  " Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
