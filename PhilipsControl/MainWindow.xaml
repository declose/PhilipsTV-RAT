                                            <ItemsControl x:Name="AudioStyles" ItemTemplate="{StaticResource StyleChip}" ItemsPanel="{StaticResource WrapItems}"/>
                                            <TextBlock Text="FOLLOW COLOR" Style="{StaticResource SectionLabel}" Margin="0,14,0,0"/>
                                            <TextBlock Text="A calm, static color scene." Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                                            <ItemsControl x:Name="ColorStyles" ItemTemplate="{StaticResource StyleChip}" ItemsPanel="{StaticResource WrapItems}"/>
                                            <TextBlock Text="Available styles depend on the TV model and firmware." Style="{StaticResource Hint}" Foreground="{StaticResource Faint}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOM COLOR" Style="{StaticResource SectionLabel}"/>
                                        <Grid Height="190" Margin="0,4,0,8" ClipToBounds="True">
                                            <Border x:Name="TvMock" Width="210" Height="118" CornerRadius="3" Background="#030403" BorderBrush="#1C1F1C" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Effect><DropShadowEffect x:Name="PreviewGlow" ShadowDepth="0" BlurRadius="80" Opacity="1" Color="#FF6A1A"/></Border.Effect>
                                                <TextBlock x:Name="ColorHexText" Text="#FF6A1A" Foreground="#3A423B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="HUE" Style="{StaticResource Caption}"/>
                                        <Slider x:Name="HueSlider" Style="{StaticResource GradientSlider}" Minimum="0" Maximum="360" Value="22" ValueChanged="ColorSlider_ValueChanged" Margin="0,2,0,8">
                                            <Slider.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.1667"/><GradientStop Color="#00FF00" Offset="0.3333"/>
                                                    <GradientStop Color="#00FFFF" Offset="0.5"/><GradientStop Color="#0000FF" Offset="0.6667"/><GradientStop Color="#FF00FF" Offset="0.8333"/><GradientStop Color="#FF0000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Slider.Background>
                                        </Slider>
                                        <TextBlock Text="SATURATION" Style="{StaticResource Caption}"/>
                                        <Slider x:Name="SatSlider" Style="{StaticResource GradientSlider}" Minimum="0" Maximum="100" Value="90" ValueChanged="ColorSlider_ValueChanged" Margin="0,2,0,8">
                                            <Slider.Background><LinearGradientBrush x:Name="SatGradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop x:Name="SatGradientEnd" Color="#FF6A1A" Offset="1"/></LinearGradientBrush></Slider.Background>
                                        </Slider>
                                        <TextBlock Text="BRIGHTNESS" Style="{StaticResource Caption}"/>
                                        <Slider x:Name="BrightSlider" Style="{StaticResource GradientSlider}" Minimum="5" Maximum="100" Value="100" ValueChanged="ColorSlider_ValueChanged" Margin="0,2,0,10">
                                            <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Black" Offset="0"/><GradientStop x:Name="BrightGradientEnd" Color="#FF6A1A" Offset="1"/></LinearGradientBrush></Slider.Background>
                                        </Slider>
                                        <TextBlock Text="PRESETS" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                        <ItemsControl x:Name="SwatchList" ItemsPanel="{StaticResource WrapItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="30" Height="30" Margin="0,0,7,7" Padding="0" Tag="{Binding}" Click="Swatch_Click" ToolTip="{Binding}">
                                                        <Border Width="22" Height="22" CornerRadius="11" Background="{Binding}"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,8,0,0">
                                            <CheckBox x:Name="LiveColorSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Left">
                                                <TextBlock Text="Live" Foreground="{StaticResource Dim}"/>
                                            </CheckBox>
                                            <Button Content="[ APPLY COLOR ]" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ApplyColor_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ CONSOLE ============ -->
                        <Grid x:Name="LogPage" Visibility="Collapsed" Margin="0,0,0,16">
                            <Border Style="{StaticResource Card}" Margin="0" Background="{StaticResource Inset}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SESSION CONSOLE" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock Text="Commands sent to the TV, connection events and errors." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="[ COPY ]" Click="CopyLog_Click" Margin="0,0,8,0"/>
                                            <Button Content="[ CLEAR ]" Click="ClearLog_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="LogList" Grid.Row="1" ItemTemplate="{StaticResource LogRow}" FontSize="12" VirtualizingPanel.IsVirtualizing="True">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl"><ScrollViewer x:Name="LogScroll" CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                                        </ItemsControl.Template>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============ SETTINGS ============ -->
                        <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,8,0">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ADD A PHILIPS TV" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox x:Name="HostInput" Style="{StaticResource TextField}" Tag="IP address or hostname, e.g. 192.168.1.42" KeyDown="HostInput_KeyDown"/>
                                                <Button Grid.Column="1" Content="[ CONNECT ]" Margin="8,0,0,0" Click="AddHost_Click"/>
                                                <Button x:Name="DiscoverButton" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Discover_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock x:Name="DiscoverButtonText" Text="SCAN NETWORK" Margin="8,0,0,0"/></StackPanel>
                                                </Button>
                                            </Grid>
                                            <ProgressBar x:Name="ScanProgress" Margin="0,10,0,0" Maximum="1" Value="0" Visibility="Hidden"/>
                                            <TextBlock x:Name="DiscoveryStatus" Text="Scan your local network or enter the TV's IP address." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                            <ItemsControl x:Name="FoundTVList" ItemTemplate="{StaticResource FoundTvRow}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="SAVED TELEVISIONS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                                            <ItemsControl x:Name="SavedTVList" ItemTemplate="{StaticResource SavedTvRow}"/>
                                            <TextBlock x:Name="NoSavedText" Text="No saved TVs yet." Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE TV / WAKE-ON-LAN" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="MODEL" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ModelLabel}"/>
                                                <TextBlock Grid.Row="1" Text="HOST" Style="{StaticResource Caption}" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Host}" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Row="2" Text="PROTOCOL" Style="{StaticResource Caption}" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ApiLabel}" Margin="0,8,0,0"/>
                                                <TextBlock Grid.Row="3" Text="TV MAC" Style="{StaticResource Caption}" Margin="0,12,0,0" VerticalAlignment="Center"/>
                                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="MacInput" Style="{StaticResource TextField}" Tag="AA:BB:CC:DD:EE:FF"/>
                                                    <Button Grid.Column="1" Content="[ DETECT ]" Margin="6,0,0,0" Click="DetectMac_Click" ToolTip="Read the MAC from the ARP table (the TV must be on)"/>
                                                    <Button Grid.Column="2" Content="[ SAVE ]" Margin="6,0,0,0" Click="SaveMac_Click"/>
                                                    <Button Grid.Column="3" Content="[ WAKE ]" Margin="6,0,0,0" Click="SendWake_Click" ToolTip="Send a Wake-on-LAN packet now"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Text="Wake-on-LAN must be enabled on the TV (Settings › Network › Switch on with Wi-Fi / Wake on LAN)." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                            <Button Content="[ PAIR AGAIN ]" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Repair_Click" ToolTip="Forget the stored pairing and request a new PIN from the TV"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock Text="Terminal accent color" Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                                            <WrapPanel x:Name="AccentChips"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                            <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource Switch}" Click="PreferenceSwitch_Click" Margin="0,0,0,12">
                                                <StackPanel><TextBlock Text="Keep running in the tray"/><TextBlock Text="Closing the window hides it next to the clock." Style="{StaticResource Hint}" Margin="0,2,0,0"/></StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Click="StartupSwitch_Click" Margin="0,0,0,12">
                                                <StackPanel><TextBlock Text="Start with Windows"/><TextBlock Text="Launches minimized to the tray." Style="{StaticResource Hint}" Margin="0,2,0,0"/></StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="ShortcutsSwitch" Style="{StaticResource Switch}" Click="PreferenceSwitch_Click" Margin="0,0,0,12">
                                                <StackPanel><TextBlock Text="Keyboard control"/><TextBlock Text="Arrows, Enter, +/-, M and more drive the TV." Style="{StaticResource Hint}" Margin="0,2,0,0"/></StackPanel>
                                            </CheckBox>
                                            <CheckBox x:Name="NotificationsSwitch" Style="{StaticResource Switch}" Click="PreferenceSwitch_Click">
                                                <StackPanel><TextBlock Text="Pop-up notifications"/><TextBlock Text="Short in-app toasts for results and errors." Style="{StaticResource Hint}" Margin="0,2,0,0"/></StackPanel>
                                            </CheckBox>
                                            <TextBlock Text="STATUS REFRESH" Style="{StaticResource Caption}" Margin="0,16,0,8"/>
                                            <WrapPanel x:Name="PollChips">
                                                <RadioButton Content="2s" CommandParameter="2" GroupName="Poll" Style="{StaticResource Chip}" Checked="PollChip_Click"/>
                                                <RadioButton Content="5s" CommandParameter="5" GroupName="Poll" Style="{StaticResource Chip}" Checked="PollChip_Click"/>
                                                <RadioButton Content="10s" CommandParameter="10" GroupName="Poll" Style="{StaticResource Chip}" Checked="PollChip_Click"/>
                                                <RadioButton Content="30s" CommandParameter="30" GroupName="Poll" Style="{StaticResource Chip}" Checked="PollChip_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="VersionText" Text="Philips Control" Margin="0,8,0,0"/>
                                            <TextBlock Text="Pairing credentials are encrypted with Windows DPAPI and never leave this PC." Style="{StaticResource Hint}" Margin="0,6,0,10"/>
                                            <Button Content="[ OPEN DATA FOLDER ]" HorizontalAlignment="Left" Click="OpenDataFolder_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Toasts -->
                <StackPanel x:Name="ToastHost" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,18" Width="340"/>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Panel}">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusKind" Text="READY" Foreground="{DynamicResource Accent}" FontSize="11"/>
                        <TextBlock x:Name="StatusText" Text="  PHILIPS JOINTSPACE  |  LOCAL NETWORK CONTROL" Foreground="{StaticResource Dim}" FontSize="11" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusSleep" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding ApiLabel}" Foreground="{StaticResource Faint}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
