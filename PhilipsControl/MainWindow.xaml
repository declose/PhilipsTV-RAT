                                            <Button Tag="YellowColour" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" MinHeight="30" Padding="0" ToolTip="Yellow"><Border Width="34" Height="5" CornerRadius="2.5" Background="#F0D95B"/></Button>
                                            <Button Tag="BlueColour" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" MinHeight="30" Padding="0" ToolTip="Blue"><Border Width="34" Height="5" CornerRadius="2.5" Background="#72A8FF"/></Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="2" MaxWidth="560" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="NUMBER PAD" Style="{StaticResource SectionLabel}"/>
