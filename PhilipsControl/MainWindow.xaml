                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Tag="Previous" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" Width="46" ToolTip="Previous"><TextBlock Text="&#xE892;" Style="{StaticResource Icon}"/></Button>
                                        <Button Tag="Rewind" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" Width="46" ToolTip="Rewind"><TextBlock Text="&#xEB9E;" Style="{StaticResource Icon}"/></Button>
                                        <Button Tag="PlayPause" Click="RemoteKey_Click" Style="{StaticResource PrimaryButton}" Width="58" Height="44" Margin="3" ToolTip="Play / Pause"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="16"/></Button>
                                        <Button Tag="FastForward" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" Width="46" ToolTip="Fast forward"><TextBlock Text="&#xEB9D;" Style="{StaticResource Icon}"/></Button>
                                        <Button Tag="Next" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" Width="46" ToolTip="Next"><TextBlock Text="&#xE893;" Style="{StaticResource Icon}"/></Button>
                                        <Button Tag="Stop" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" Width="46" ToolTip="Stop"><TextBlock Text="&#xE71A;" Style="{StaticResource Icon}"/></Button>
                                        <Border Width="1" Background="{StaticResource Line}" Margin="10,6"/>
                                        <Button Tag="ChannelStepDown" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" Padding="12,0" ToolTip="Channel down"><TextBlock Text="CH −"/></Button>
                                        <Button Tag="ChannelStepUp" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" Padding="12,0" ToolTip="Channel up"><TextBlock Text="CH +"/></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="CHANNEL LIST" Style="{StaticResource SectionLabel}"/>
                                                <TextBlock x:Name="ChannelsStatus" Text="Load the channel list from the TV to zap with one click." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBox x:Name="ChannelSearch" Grid.Column="1" Style="{StaticResource TextField}" Tag="Filter channels..." TextChanged="ChannelSearch_TextChanged" Margin="10,0,8,0"/>
                                            <Button x:Name="LoadChannelsButton" Grid.Column="2" Content="[ LOAD CHANNELS ]" Click="LoadChannels_Click"/>
                                        </Grid>
                                        <Border Grid.Row="1" Height="1" Background="{StaticResource LineSoft}" Margin="0,12"/>
                                        <ItemsControl x:Name="ChannelsList" Grid.Row="2" ItemTemplate="{StaticResource ChannelRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="ItemsControl"><ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                                            </ItemsControl.Template>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <Border x:Name="SourcesCard" Grid.Column="1" Style="{StaticResource Card}" Width="220" Margin="12,0,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="INPUTS" Style="{StaticResource SectionLabel}"/>
