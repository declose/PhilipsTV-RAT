                                                <RadioButton Content="30m" CommandParameter="30" GroupName="Sleep" Style="{StaticResource Chip}" Click="SleepChip_Click"/>
                                                <RadioButton Content="60m" CommandParameter="60" GroupName="Sleep" Style="{StaticResource Chip}" Click="SleepChip_Click"/>
