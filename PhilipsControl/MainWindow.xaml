                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                <StackPanel Margin="0,0,0,16">
                                    <StackPanel x:Name="FavoritesSection">
                                        <TextBlock Text="★ PINNED" Style="{StaticResource SectionLabel}" Foreground="{StaticResource Warn}" Margin="0,0,0,10"/>
