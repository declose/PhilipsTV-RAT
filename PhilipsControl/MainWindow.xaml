                                            </Grid>
                                            <WrapPanel x:Name="SleepChips" Margin="0,12,0,0">
                                                <RadioButton Content="OFF" CommandParameter="0" GroupName="Sleep" Style="{StaticResource Chip}" Click="SleepChip_Click" IsChecked="True"/>
