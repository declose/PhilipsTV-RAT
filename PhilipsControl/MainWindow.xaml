<Window x:Class="PhilipsControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PhilipsControl.Models"
        xmlns:local="clr-namespace:PhilipsControl"
        Title="Philips Control" Width="1220" Height="800" MinWidth="980" MinHeight="660"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Mono}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BoolVisibilityConverter x:Key="Visible"/>
        <local:StateBrushConverter x:Key="StateBrush"/>
        <local:LogKindBrushConverter x:Key="LogBrush"/>
        <local:TileBrushConverter x:Key="TileBrush"/>
        <local:InitialsConverter x:Key="Initials"/>

        <Style x:Key="StarToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Star" Text="&#xE734;" Style="{StaticResource Icon}" FontSize="13" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Star" Property="Text" Value="&#xE735;"/>
                                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AppTile" DataType="models:TvApplication">
            <Button x:Name="Tile" AutomationProperties.Name="{Binding Label}" Width="150" Height="116" Margin="0,0,10,10" Padding="0" Tag="{Binding}" Click="LaunchApp_Click"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip="{Binding Label}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="9" Background="{Binding Label, Converter={StaticResource TileBrush}}">
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="16" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Label}" Margin="8,9,8,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="132"/>
                        <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource Accent}" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ToggleButton Style="{StaticResource StarToggle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}" Tag="{Binding}" Click="FavoriteToggle_Click" ToolTip="Pin to Overview"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AppChip" DataType="models:TvApplication">
            <Button x:Name="Chip" AutomationProperties.Name="{Binding Label}" Tag="{Binding}" Click="LaunchApp_Click" Margin="0,0,8,8" Padding="8,6,12,6" ToolTip="{Binding Label}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="5" Background="{Binding Label, Converter={StaticResource TileBrush}}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Label}" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ChannelRow" DataType="models:TvChannel">
            <Button x:Name="Row" Tag="{Binding}" Click="Channel_Click" AutomationProperties.Name="{Binding Name}" HorizontalContentAlignment="Stretch" Padding="10,7" Margin="0,0,4,2" Background="Transparent" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PresetLabel}" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="OnAir" Grid.Column="2" Text="● ON AIR" Foreground="{DynamicResource Accent}" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter TargetName="OnAir" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StyleChip" DataType="local:AmbilightStyleItem">
            <Button x:Name="Chip" Content="{Binding Style.Label}" Tag="{Binding}" Style="{StaticResource ChipButton}" Click="AmbilightStyle_Click"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Chip" Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SavedTvRow" DataType="models:TvRecord">
            <Border x:Name="Row" Background="{StaticResource Inset}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Glyph" Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Dim}"/>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="ActiveBadge" Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="5,0" Visibility="Collapsed">
                                <TextBlock Text="ACTIVE" FontSize="9" Foreground="{DynamicResource Accent}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0}  ·  {1}  ·  last seen {2}"><Binding Path="Host"/><Binding Path="ModelLabel"/><Binding Path="LastSeen"/></MultiBinding></TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="CONNECT" Tag="{Binding}" Margin="0,0,6,0" Padding="10,6" Click="SavedTV_Click"/>
                        <Button Tag="{Binding}" Margin="0,0,6,0" Padding="9,6" Click="RenameTV_Click" ToolTip="Rename"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12"/></Button>
                        <Button Tag="{Binding}" Style="{StaticResource DangerButton}" Padding="9,6" Click="RemoveTV_Click" ToolTip="Remove"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="FoundTvRow" DataType="models:DiscoveryResult">
            <Border Background="{StaticResource Inset}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="3" Padding="12,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Accent}"/>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="[ ADD &amp; CONNECT ]" Tag="{Binding}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="FoundTV_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SidebarTv" DataType="models:TvRecord">
            <Button x:Name="B" Tag="{Binding}" Click="SavedTV_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,1" ToolTip="{Binding Host}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Faint}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding DisplayName}" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{Binding StateBadge, Converter={StaticResource StateBrush}}"/>
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LogRow" DataType="models:LogEntry">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource Faint}"/>
                <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Foreground="{Binding Kind, Converter={StaticResource LogBrush}}"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapItems"><WrapPanel/></ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>

            <!-- Title bar (WindowChrome handles dragging, snapping and double-click maximize) -->
            <Grid Grid.Row="0" Background="{StaticResource Panel}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Image Source="Assets/app.ico" Width="18" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PHILIPS CONTROL" Foreground="{DynamicResource Accent}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  //  LOCAL TV TERMINAL" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleCursor" Text=" _" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,16,0">
                    <Ellipse x:Name="HeaderOnlineDot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HeaderStatus" Text="Initializing..." Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#xE921;" Style="{StaticResource ChromeButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource ChromeButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseChromeButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="COMMANDS" Style="{StaticResource SectionLabel}" Margin="10,8,0,10"/>
                            <RadioButton x:Name="NavOverview" Content="Overview" Tag="&#xE80F;" CommandParameter="overview" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Ctrl+1"/>
                            <RadioButton x:Name="NavRemote" Content="Remote" Tag="&#xE951;" CommandParameter="remote" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Ctrl+2"/>
                            <RadioButton x:Name="NavMedia" Content="Media &amp; TV" Tag="&#xE714;" CommandParameter="media" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Ctrl+3"/>
                            <RadioButton x:Name="NavApps" Content="Apps" Tag="&#xE71D;" CommandParameter="apps" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Ctrl+4"/>
                            <RadioButton x:Name="NavAmbilight" Content="Ambilight" Tag="&#xE706;" CommandParameter="ambilight" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Ctrl+5"/>
                            <RadioButton x:Name="NavLog" Content="Console" Tag="&#xE756;" CommandParameter="log" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Ctrl+6"/>
                            <RadioButton x:Name="NavSettings" Content="Settings" Tag="&#xE713;" CommandParameter="settings" Style="{StaticResource NavItem}" Checked="Nav_Checked" ToolTip="Ctrl+7"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,10"/>
                            <TextBlock Text="TELEVISIONS" Style="{StaticResource SectionLabel}" Margin="10,0,0,6"/>
                            <ItemsControl x:Name="SidebarTvList" ItemTemplate="{StaticResource SidebarTv}"/>
                            <Button Margin="0,8,0,0" Click="OpenSettings_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11"/><TextBlock Text="ADD TV" Margin="8,0,0,0"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="24,16,24,0" MaxWidth="1680" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageEyebrow" Text="PHILIPS TV / OVERVIEW" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="PageHeading" Text="Overview" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="SleepBadge" Style="{StaticResource Badge}" Margin="0,0,10,0" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="SleepBadge_Click" ToolTip="Sleep timer active. Click to cancel.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="SleepBadgeText" Text="30:00" Foreground="{DynamicResource Accent}" Margin="6,0,0,0" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Button Click="Refresh_Click" Margin="0,0,8,0" ToolTip="Refresh (F5)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="REFRESH" Margin="8,0,0,0"/></StackPanel>
                            </Button>
                            <Button x:Name="PowerButton" Style="{StaticResource PrimaryButton}" Click="PowerButton_Click" ToolTip="Power (P)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock x:Name="PowerButtonText" Text="POWER ON" Margin="8,0,0,0"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- ============ OVERVIEW ============ -->
                        <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*" MinWidth="310"/></Grid.ColumnDefinitions>

                                <Border x:Name="Banner" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="14,12" Visibility="Collapsed" BorderBrush="{StaticResource Warn}" Background="#161409">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Warn}"/>
                                        <StackPanel Grid.Column="1" Margin="14,0">
                                            <TextBlock x:Name="BannerTitle" Text="TV OFFLINE" Foreground="{StaticResource Warn}" FontWeight="Bold"/>
                                            <TextBlock x:Name="BannerText" Text="" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BannerAction" Grid.Column="2" Content="[ WAKE TV ]" VerticalAlignment="Center" Click="BannerAction_Click"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <!-- Device -->
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Border Width="60" Height="60" CornerRadius="6" Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="28" Foreground="{Binding StateBadge, Converter={StaticResource StateBrush}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ModelLabel}" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Badge}" Background="Transparent" BorderBrush="{Binding StateBadge, Converter={StaticResource StateBrush}}" Padding="9,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StateBadge, Converter={StaticResource StateBrush}}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StateBadge}" Foreground="{Binding StateBadge, Converter={StaticResource StateBrush}}" FontSize="11" FontWeight="Bold" Margin="7,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Columns="4" Margin="0,18,0,0">
                                                <StackPanel><TextBlock Text="POWER" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PowerLabel}" Style="{StaticResource DataValue}"/></StackPanel>
                                                <StackPanel><TextBlock Text="NETWORK HOST" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Host}" Style="{StaticResource DataValue}"/></StackPanel>
                                                <StackPanel><TextBlock Text="AMBILIGHT" Style="{StaticResource Caption}"/><TextBlock Text="{Binding AmbilightLabel}" Style="{StaticResource DataValue}"/></StackPanel>
                                                <StackPanel><TextBlock Text="LAST SEEN" Style="{StaticResource Caption}"/><TextBlock Text="{Binding LastSeen}" Style="{StaticResource DataValue}" FontSize="12"/></StackPanel>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>

                                    <!-- Now playing -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="NOW ON TV" Style="{StaticResource SectionLabel}"/>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="58" Height="58" CornerRadius="11" Background="{Binding CurrentApp, Converter={StaticResource TileBrush}}">
                                                    <TextBlock Text="{Binding CurrentApp, Converter={StaticResource Initials}}" Foreground="White" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CurrentApp}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CurrentActivity}" Foreground="{StaticResource Dim}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Tag="Rewind" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Padding="9" ToolTip="Rewind"><TextBlock Text="&#xEB9E;" Style="{StaticResource Icon}"/></Button>
                                                    <Button Tag="PlayPause" Click="RemoteKey_Click" Padding="12,9" ToolTip="Play / Pause (Space)"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"/></Button>
                                                    <Button Tag="FastForward" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Padding="9" ToolTip="Fast forward"><TextBlock Text="&#xEB9D;" Style="{StaticResource Icon}"/></Button>
                                                </StackPanel>
                                            </Grid>
                                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                                <StackPanel><TextBlock Text="SOURCE" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentInput}" Style="{StaticResource DataValue}"/></StackPanel>
                                                <StackPanel><TextBlock Text="CHANNEL" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentChannel}" Style="{StaticResource DataValue}"/></StackPanel>
                                                <StackPanel><TextBlock Text="PLAYBACK" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PlaybackStatus}" Style="{StaticResource DataValue}" TextWrapping="Wrap" TextTrimming="None"/></StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pinned apps -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="PINNED APPS" Style="{StaticResource SectionLabel}"/>
                                                <Button Content="ALL APPS →" Style="{StaticResource GhostButton}" Padding="4,0" HorizontalAlignment="Right" Foreground="{StaticResource Dim}" Tag="apps" Click="GoToPage_Click"/>
                                            </Grid>
                                            <ItemsControl x:Name="PinnedAppsList" ItemTemplate="{StaticResource AppChip}" ItemsPanel="{StaticResource WrapItems}" Margin="0,12,0,0"/>
                                            <TextBlock x:Name="NoPinnedText" Text="Star apps on the Apps page to launch them from here with one click." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <!-- Volume -->
                                    <Border Style="{StaticResource Card}" MouseWheel="Volume_MouseWheel" Background="{StaticResource Panel}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="VOLUME" Style="{StaticResource SectionLabel}"/>
                                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" BorderBrush="{StaticResource Danger}" Background="Transparent" Padding="6,1"
                                                        Visibility="{Binding IsMuted, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="MUTED" Foreground="{StaticResource Danger}" FontSize="10"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                                <TextBlock Text="{Binding Volume}" FontSize="48" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Text="{Binding MaxVolume, StringFormat=/ {0}}" Foreground="{StaticResource Faint}" FontSize="14" VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                                            </StackPanel>
                                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="60" SmallChange="1" LargeChange="5" ValueChanged="VolumeSlider_ValueChanged"/>
                                            <UniformGrid Columns="3" Margin="-3,10,-3,0">
                                                <Button Tag="VolumeDown" Click="RemoteKey_Click" Margin="3" ToolTip="Volume down (-)"><TextBlock Text="&#xE993;" Style="{StaticResource Icon}"/></Button>
                                                <Button Tag="Mute" Click="RemoteKey_Click" Margin="3" ToolTip="Mute (M)"><TextBlock Text="&#xE74F;" Style="{StaticResource Icon}"/></Button>
                                                <Button Tag="VolumeUp" Click="RemoteKey_Click" Margin="3" ToolTip="Volume up (+)"><TextBlock Text="&#xE995;" Style="{StaticResource Icon}"/></Button>
                                            </UniformGrid>
                                            <TextBlock Text="Tip: scroll the mouse wheel over this card." Style="{StaticResource Hint}" Foreground="{StaticResource Faint}" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick actions -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource SectionLabel}"/>
                                            <UniformGrid Columns="3" Margin="-3,10,-3,0">
                                                <Button Tag="Home" Click="RemoteKey_Click" Margin="3" Padding="6,10"><StackPanel><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="HOME" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                                <Button Tag="Back" Click="RemoteKey_Click" Margin="3" Padding="6,10"><StackPanel><TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="BACK" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                                                <Button Tag="Source" Click="RemoteKey_Click" Margin="3" Padding="6,10"><StackPanel><TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="SOURCE" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
