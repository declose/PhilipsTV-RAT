                                                <Button Content="1" Tag="Digit1" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/><Button Content="2" Tag="Digit2" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/><Button Content="3" Tag="Digit3" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/>
                                                <Button Content="4" Tag="Digit4" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/><Button Content="5" Tag="Digit5" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/><Button Content="6" Tag="Digit6" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/>
                                                <Button Content="7" Tag="Digit7" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/><Button Content="8" Tag="Digit8" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/><Button Content="9" Tag="Digit9" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/>
                                                <Button Content="TXT" Tag="Teletext" Style="{StaticResource KeyButton}" Click="RemoteKey_Click" Foreground="{StaticResource Dim}" ToolTip="Teletext"/><Button Content="0" Tag="Digit0" Style="{StaticResource KeyButton}" Click="RemoteKey_Click"/><Button Content="SUBS" Tag="Subtitle" Style="{StaticResource KeyButton}" Click="RemoteKey_Click" Foreground="{StaticResource Dim}" ToolTip="Subtitles"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="MORE KEYS" Style="{StaticResource SectionLabel}"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="ADJUST" Tag="Adjust" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                                <Button Content="SEARCH" Tag="Find" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                                <Button Content="LIVE TV" Tag="WatchTV" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                                <Button Content="VIEW MODE" Tag="Viewmode" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                                <Button Content="ONLINE" Tag="Online" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                                <Button Content="|◀ PREV" Tag="Previous" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                                <Button Content="NEXT ▶|" Tag="Next" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                                <Button Content="PLAY" Tag="Play" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                                <Button Content="PAUSE" Tag="Pause" Margin="0,0,6,6" Click="RemoteKey_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="KEYBOARD CONTROL" Style="{StaticResource SectionLabel}"/>
                                                <TextBlock x:Name="KeyboardStateText" Text="ON" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontSize="11"/>
                                            </Grid>
                                            <TextBlock Text="Control the TV from your keyboard while this window has focus." Style="{StaticResource Hint}" Margin="0,6,0,10"/>
                                            <Grid TextElement.FontSize="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <TextBlock Text="← ↑ → ↓" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="1" Text="Navigate" Foreground="{StaticResource Dim}"/>
                                                <TextBlock Grid.Column="2" Text="+  /  -" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="3" Text="Volume" Foreground="{StaticResource Dim}"/>
                                                <TextBlock Grid.Row="1" Text="Enter" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="OK" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="M" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="1" Grid.Column="3" Text="Mute" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="2" Text="Backspace / Esc" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Back" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="PgUp / PgDn" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Grid.Column="3" Text="Channel" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="3" Text="H" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Home" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="0 - 9" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="3" Grid.Column="3" Text="Digits" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="4" Text="Space" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Play / Pause" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="S  /  I  /  O" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="4" Grid.Column="3" Text="Source/Info/Opt" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="5" Text="P" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Power" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Ctrl+1..7" Foreground="{DynamicResource Accent}" Margin="0,5,0,0"/><TextBlock Grid.Row="5" Grid.Column="3" Text="Pages" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ MEDIA & TV ============ -->
                        <Grid x:Name="MediaPage" Visibility="Collapsed" Margin="0,0,0,16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CURRENT MEDIA SESSION" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{Binding CurrentApp}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
