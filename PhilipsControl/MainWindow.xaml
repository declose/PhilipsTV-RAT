                                                    <Button Tag="ChannelStepDown" Click="RemoteKey_Click" Style="{StaticResource GhostButton}" Height="48" ToolTip="Channel down (Page Down)"><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}"/></Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <UniformGrid Columns="5" Margin="-3,16,-3,0">
                                            <Button Tag="Rewind" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" ToolTip="Rewind"><TextBlock Text="&#xEB9E;" Style="{StaticResource Icon}"/></Button>
                                            <Button Tag="PlayPause" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" ToolTip="Play / Pause (Space)"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"/></Button>
                                            <Button Tag="FastForward" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" ToolTip="Fast forward"><TextBlock Text="&#xEB9D;" Style="{StaticResource Icon}"/></Button>
                                            <Button Tag="Stop" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" ToolTip="Stop"><TextBlock Text="&#xE71A;" Style="{StaticResource Icon}"/></Button>
                                            <Button Tag="Record" Click="RemoteKey_Click" Style="{StaticResource KeyButton}" ToolTip="Record"><TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" Foreground="{StaticResource Danger}"/></Button>
                                        </UniformGrid>

                                        <UniformGrid Columns="4" Margin="-3,8,-3,0">
