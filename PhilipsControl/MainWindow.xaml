                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:TvSource">
                                                    <Button Content="{Binding Name}" Tag="{Binding}" Click="Source_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ============ APPS ============ -->
                        <Grid x:Name="AppsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
